# 키 이름과 설명만 기록한다. 실제 값은 Vercel 환경 변수(Sensitive)로만 등록하고 이 파일·커밋·로그에 남기지 않는다.

# 카카오 REST API 키 (서버 전용). 길찾기(TASK-005)와 로컬 장소 검색에 사용
KAKAO_REST_API_KEY=
# 장소 검색 공급자. "kakao"이고 KAKAO_REST_API_KEY가 있을 때만 실제 호출, 그 외에는 모의 데이터 (실호출은 별도 승인 후)
PLACES_PROVIDER=
# 경로 공급자. "kakao"이고 KAKAO_REST_API_KEY가 있을 때만 카카오모빌리티 호출, 그 외에는 모의 데이터
ROUTES_PROVIDER=
# 제주 ITS 오픈API 키 (서버 전용, 국외 IP 차단이라 Vercel icn1 함수에서만 동작)
JEJU_ITS_API_KEY=
# 제주 ITS 실시간 교통정보(getFrafficInfo, 구간 속도) 전용 키 (서버 전용, Sensitive). TASK-012에서 따로 활용 신청·발급. 기존 키와 별도
JEJU_ITS_TRAFFIC_API_KEY=
# 제주 ITS 교통시설물정보(getFacilityInfo) 전용 키 (서버 전용, Sensitive). TASK-013에서 따로 활용 신청·발급. 없으면 기존 키
JEJU_ITS_FACILITY_API_KEY=
# 교통 사건 공급자. "jejuIts"이고 JEJU_ITS_API_KEY가 있을 때만 제주 ITS 호출, 그 외에는 모의 데이터
TRAFFIC_PROVIDER=
# AI 설명(Cloudflare Workers AI). AI_PROVIDER="cloudflare"이고 계정 ID·토큰이 있을 때만 호출, 그 외에는 규칙 기반 설명만
AI_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
# Workers AI 권한만 준 API 토큰 (서버 전용, Sensitive)
CLOUDFLARE_AI_TOKEN=
# 선택: Workers AI 모델 이름(비우면 코드 기본값)
CF_AI_MODEL=
# 브이월드 2D 데이터 API 인증키(서버 전용, Sensitive). 교통링크(LT_L_MOCTLINK) 모양으로 /traffic 구간 속도 지도 표시(TASK-012)
VWORLD_API_KEY=

# 공공데이터포털 인증키(TASK-016, 제주시 주정차 단속 CCTV). 인코딩·일반(Decoding) 키 모두 가능. 없으면 모의 데이터.
DATA_GO_KR_API_KEY=

# 오피넷 유가정보 무료 API 키(TASK-018, 제주 주유소·가격). 없으면 모의 데이터.
OPINET_API_KEY=
